# Copy to .env for local dev (cd backend && npm run dev). In Docker these are
# set via docker-compose.yml's environment: block instead.

PORT=3001
DATA_DIR=./data
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@proxyforge.local
# ADMIN_INITIAL_PASSWORD=set-a-fixed-password-here

# Real nginx/certbot binaries aren't required for API/UI development, only
# for actually deploying a workflow (which needs the container).
NGINX_BIN=nginx
NGINX_MAIN_CONF=/etc/nginx/nginx.conf
CERTBOT_BIN=certbot
