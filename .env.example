# Copy this file to .env (same folder as docker-compose.yml) and fill in
# real values before running in production. .env is gitignored — never
# commit real secrets here or in docker-compose.yml itself.

# Optional. Leave unset for local/throwaway testing — the admin account is
# then created as admin@proxyforge.local / changeme, forced to change on
# first login. Set a real password here before exposing port 81 beyond
# localhost.
ADMIN_INITIAL_PASSWORD=

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=
